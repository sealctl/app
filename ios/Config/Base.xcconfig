// Build settings for sealctl (SPEC.md 3, 8.1). Values that must not be committed (a staging
// relay, a shortened test delay) go in Local.xcconfig next to this file, which git ignores:
//
//   SEALCTL_RELAY_URL = https:/$()/relay-staging.example.org
//   SEALCTL_TEST_DELAY_SECS = 20
//
// `https:/$()/` keeps the `//` from starting an xcconfig comment.
SEALCTL_RELAY_URL = https:/$()/relay.sealctl.com
SEALCTL_TEST_DELAY_SECS = 0
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

#include? "Local.xcconfig"
